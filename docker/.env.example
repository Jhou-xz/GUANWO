# =============================================================================
# GuanWo (观我) - Environment Variables Template
# =============================================================================
# Copy this file to .env.production (for production) or .env.development (for dev)
# NEVER commit .env.production to git - it contains secrets!
# =============================================================================

# =============================================================================
# Django Core Settings
# =============================================================================

# Django secret key - generate a new one for production!
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-secret-key-here-change-me-in-production

# Debug mode - NEVER True in production
DEBUG=False

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,localhost,127.0.0.1

# Django settings module
DJANGO_SETTINGS_MODULE=server.settings

# Server IP (for internal health checks)
SERVER_IP=123.456.789.012

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL connection URL
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://guanwo:your-secure-postgres-password@postgres:5432/guanwo

# Individual DB settings (used by docker-compose for postgres init)
POSTGRES_DB=guanwo
POSTGRES_USER=guanwo
POSTGRES_PASSWORD=your-secure-postgres-password-here

# =============================================================================
# Redis Configuration
# =============================================================================

# Redis connection URL
# Format: redis://HOST:PORT/DB_NUMBER
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Security Settings
# =============================================================================

# CSRF trusted origins (for production)
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# CORS allowed origins (for production)
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com,http://localhost:5173

# =============================================================================
# DeepSeek AI API Configuration
# =============================================================================

# DeepSeek API key - get from https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# DeepSeek API base URL
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# =============================================================================
# WeChat OAuth Configuration
# =============================================================================

# WeChat Open Platform App ID
WECHAT_APP_ID=wx-your-app-id-here

# WeChat Open Platform App Secret
WECHAT_APP_SECRET=your-wechat-app-secret-here

# WeChat OAuth redirect URI (must match WeChat console config)
WECHAT_REDIRECT_URI=https://your-domain.com/api/auth/wechat/callback/

# =============================================================================
# Rate Limiting & Quotas
# =============================================================================

# Daily AI request quota for anonymous users (IP-based)
RATE_LIMIT_ANONYMOUS_DAILY=3

# Daily AI request quota for authenticated (free) users
RATE_LIMIT_FREE_DAILY=10

# =============================================================================
# Monitoring & Error Tracking
# =============================================================================

# Sentry DSN for error tracking (leave empty to disable)
# Get from https://sentry.io/ or your self-hosted Sentry
SENTRY_DSN=https://your-sentry-dsn-here@sentry.io/project-id

# =============================================================================
# Domain & SSL
# =============================================================================

# Primary domain name
DOMAIN_NAME=your-domain.com

# Email for Let's Encrypt certificate notifications
CERTBOT_EMAIL=admin@your-domain.com

# =============================================================================
# Optional: Admin Configuration
# =============================================================================

# Django superuser credentials (auto-created on first run)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@your-domain.com
DJANGO_SUPERUSER_PASSWORD=change-me-immediately
