# =============================================================================
# GuanWo (观我) - Development Environment Variables Template
# =============================================================================
# Copy this file to docker/.env.development for local development:
#   cp docker/.env.development.example docker/.env.development
# These values are safe for local development only.
# =============================================================================

ENVIRONMENT=development
DEBUG=True
DJANGO_SECRET_KEY=dev-secret-key-not-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,django
SERVER_IP=127.0.0.1

DATABASE_URL=postgres://guanwo:guanwo_dev@postgres:5432/guanwo
POSTGRES_DB=guanwo
POSTGRES_USER=guanwo
POSTGRES_PASSWORD=guanwo_dev

REDIS_URL=redis://redis:6379/0

CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:8080/api/auth/wechat/callback/

RATE_LIMIT_ENABLED=False
RATE_LIMIT_ANONYMOUS_DAILY=100
RATE_LIMIT_FREE_DAILY=100

DOMAIN_NAME=localhost
CERTBOT_EMAIL=admin@localhost
