# =============================================================================
# GuanWo (观我) - Docker Ignore
# =============================================================================
# Excludes files from Docker build context to reduce image size and
# prevent secrets from being included in images.
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# Environment / Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# Python / Django Backend
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
server/staticfiles/
server/media/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.dmypy.json
dmypy.json

# Node.js / Frontend
node_modules/
.npm
dist/
dist-ssr/
build/
.vite/
*.local
*.tsbuildinfo

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
*.sublime-*

# Documentation
docs/
*.md
!README.md

# Docker (prevent recursion)
docker/
docker-compose*.yml
Dockerfile*

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Misc
*.tmp
*.temp
.cache/
.terraform/
*.tfstate
backups/
.pgdata/
coverage/
