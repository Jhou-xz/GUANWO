# =============================================================================
# GuanWo (观我) — Frontend Docker Image
# =============================================================================
# Multi-stage build for the Vite React SPA.
#
# Stage 1 (builder): Install dependencies and build the static files.
# Stage 2 (nginx):  Serve the built files with nginx.
#
# Build:
#   docker build -f Dockerfile.frontend -t guanwo-frontend:latest .
#
# The built files are copied to /usr/share/nginx/html so they can be served
# by the central nginx container in production or by this image directly.
# =============================================================================

# ---------------------------------------------------------------------------
# STAGE 1: Builder
# ---------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

# Install dependencies first for better layer caching.
COPY package*.json ./
RUN npm ci

# Copy source and build.
COPY . .
RUN npm run build

# ---------------------------------------------------------------------------
# STAGE 2: Nginx
# ---------------------------------------------------------------------------
FROM nginx:1.26-alpine

# Remove default nginx configuration.
RUN rm -rf /etc/nginx/conf.d/default.conf

# Copy built assets.
COPY --from=builder /app/dist /usr/share/nginx/html

# Write a minimal SPA nginx config.
RUN cat > /etc/nginx/conf.d/default.conf <<'EOF'
server {
    listen       80;
    listen  [::]:80;
    server_name  localhost;

    root   /usr/share/nginx/html;
    index  index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires off;
    }

    location = /favicon.ico {
        access_log off;
        expires 1w;
    }
    location = /robots.txt {
        access_log off;
        expires 1w;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
EOF

# Ensure nginx can read the files.
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

EXPOSE 80

USER nginx

CMD ["nginx", "-g", "daemon off;"]
